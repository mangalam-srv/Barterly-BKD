PORT=4000

MONGO_URI=

JWT_SECRET=

CLIENT_URL=

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

GOOGLE_CALLBACK_URL=

CLOUDINARY_CLOUD_NAME=

CLOUDINARY_API_KEY=

CLOUDINARY_API_SECRET=

GROQ_API_KEY=

# Groq chat model shared by AI listing-generation and (as a default) the Python
# advisor. `llama-3.3-70b-versatile` was decommissioned by Groq — verify with:
#   node -e "const G=require('groq-sdk');new G().models.list().then(r=>r.data.forEach(m=>console.log(m.id)))"
AI_MODEL=openai/gpt-oss-120b

# --- AI Compare / price comparison (all optional; sensible defaults apply) ---
# Comma-separated platform ids to enable. Default: amazon,flipkart,myntra
# COMPARE_SOURCES=amazon,flipkart,myntra
# Run the scraping browser headless (set to "false" only for local debugging).
# COMPARE_HEADLESS=true
# Max results pulled from each store per search.
# COMPARE_MAX_RESULTS_PER_SOURCE=12

# --- AI Product Advisor (Python service) ---
# URL of the Python AI service that Node proxies to. Default: http://127.0.0.1:8000
# AI_SERVICE_URL=http://127.0.0.1:8000
# Optional shared secret. If set, Node sends it to Python AND the Python→Node
# comparison tool must present it — set the SAME value here and in ai/.env.
# If left empty, the internal /internal/compare-search endpoint only accepts
# loopback callers.
# AI_INTERNAL_API_KEY=
# How long Node waits for a non-streaming advisor response (ms). Default: 60000
# AI_SERVICE_TIMEOUT_MS=60000